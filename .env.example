# Copy to .env or run: .venv/bin/python jpcomedy.py --setup
# .env stays on your computer. Never upload API keys.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_LANGUAGE_CODE=jpn
AGENT_PREPASS_MODEL=codex/gpt-5.6-sol/high
AGENT_CHUNK_MODEL=codex/gpt-5.6-sol/high
AGENT_POSTPROCESS_MODEL=codex/gpt-5.6-sol/medium
AGENT_COMMON_MODEL=codex/gpt-5.6-sol/medium
ENABLE_POSTPROCESS_REFINE=true
ENABLE_POSTPROCESS_GLOSSARY_CHECK=true
ENABLE_COVER_GENERATION=false
ENABLE_BROADCAST_DATE_AGENT_FALLBACK=false
GLOSSARY_REMOTE_REPO=allen365apple/jpcomedy-glossary
GLOSSARY_REMOTE_BRANCH=main
# Set blank GLOSSARY_REMOTE_REPO to use only your local glossary.
# Leave ARCHIVED_PATH and PACKAGE_PATH unset for non-destructive local delivery.
