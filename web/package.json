{
  "name": "jpcomedy-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-data.mjs",
    "build:public": "node scripts/build-public-data.mjs && node scripts/build-public-release.mjs && node scripts/optimize-release.mjs",
    "verify:public": "PUBLIC_DIR=public-release node scripts/verify-public-artifact.mjs",
